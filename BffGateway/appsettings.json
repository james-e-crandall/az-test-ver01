{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Trace",
      "Yarp.ReverseProxy": "Trace",
      "Yarp" : "Trace"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
      "Routes": {
        "apiservice": {
          "ClusterId": "RemoteApi",
          "Match": {
            "Path": "/api/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/api"
            }
          ]
        },
        "frontend": {
          "ClusterId": "frontend",
          "Match": {
            "Path": "{**catch-all}"
          }
        },
      },
      "Clusters": {
        "RemoteApi": {
          "Destinations": {
            "apiservice": {
              "Address": "http://RemoteApi"
            }
          }
        },
        "frontend": {
          "Destinations": {
            "frontend": {
              "Address": "http://frontend"
            }
          }
        }
      }
    }
}
